---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import MissionBriefing from '../../components/project/MissionBriefing.astro';
import CrewLine from '../../components/project/CrewLine.astro';
import PushSwapGame from '../../components/games/PushSwapGame';
import FractolGame from '../../components/games/FractolGame';
import PhiloGame from '../../components/games/PhiloGame';
import MiniRtGame from '../../components/games/MiniRtGame';

export async function getStaticPaths() {
  const entries = await getCollection('arcade');
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

interface Props {
  entry: CollectionEntry<'arcade'>;
}
const { entry } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);

/** Shown under a playable game: what is actually running. */
const gameNotes: Record<string, string> = {
  'push-swap': 'This is my original push_swap C code, compiled to WebAssembly. Every move you make runs my C functions.',
  fractol:
    'This is my original fract-ol C code, compiled to WebAssembly. MiniLibX is replaced by a small web version that draws to this canvas.',
  philo:
    "This is my original philosophers C code, compiled to WebAssembly. Each philosopher is a real thread, and the table is drawn from the program's own output.",
  minirt:
    'This is our original miniRT C code, compiled to WebAssembly. It runs in a background thread, so a complex scene can take a few seconds. The error messages come from my scene parser.',
};
---

<BaseLayout title={`${d.title} · Arcade`} description={d.briefing.summary}>
  <article class="pt-14">
    <a href="/arcade" class="text-muted underline-offset-4 hover:text-cyan hover:underline">Back to the Arcade</a>
    <h1 class="font-display glow-magenta mt-4 text-2xl sm:text-4xl">{d.title}</h1>
    <p class="mt-3 text-muted">42 · Rank {d.rank}</p>
    <div class="mt-8"><MissionBriefing briefing={d.briefing} status={d.status} /></div>

    <section aria-label="Game" class="cabinet mt-12">
      {entry.id === 'push-swap' && <PushSwapGame client:visible />}
      {entry.id === 'fractol' && <FractolGame client:visible />}
      {entry.id === 'philo' && <PhiloGame client:visible />}
      {entry.id === 'minirt' && <MiniRtGame client:visible />}
      {d.status === 'coming-soon' && (
        <div class="grid min-h-72 place-items-center p-8 text-center">
          <div>
            <p class="font-display fx-blink text-sm text-magenta sm:text-base">INSERT COIN</p>
            <p class="mt-5 text-lg">This game is being ported from my original C code. It's coming soon.</p>
          </div>
        </div>
      )}
    </section>
    {gameNotes[entry.id] && <p class="mt-4 max-w-[68ch] text-muted">{gameNotes[entry.id]}</p>}

    <div class="prose-cartridge mt-12 max-w-[68ch] text-lg"><Content /></div>
    <div class="mt-10"><CrewLine crew={d.crew} /></div>
  </article>
</BaseLayout>
