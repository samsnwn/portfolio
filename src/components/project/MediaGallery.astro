---
interface Props {
  title: string;
  video?: string;
  screenshots: { src: string; alt: string }[];
}
const { title, video, screenshots } = Astro.props;
---

{
  (video || screenshots.length > 0) && (
    <section aria-label={`${title} demo`} class="mt-12 space-y-5">
      {video && (
        <video class="neon-border w-full bg-bg" src={video} autoplay muted loop playsinline controls preload="metadata" aria-label={`${title} demo video`} data-demo />
      )}
      {screenshots.length > 0 && (
        <ul class="grid gap-4 sm:grid-cols-2">
          {screenshots.map((s) => (
            <li>
              <img class="w-full border border-cyan/40" src={s.src} alt={s.alt} loading="lazy" decoding="async" />
            </li>
          ))}
        </ul>
      )}
    </section>
  )
}

<script>
  // Respect reduced motion: demo videos stay paused until the visitor presses play.
  if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    document.querySelectorAll<HTMLVideoElement>('video[data-demo]').forEach((v) => {
      v.autoplay = false;
      v.pause();
    });
  }
</script>
