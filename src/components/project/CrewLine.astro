---
import type { Crew } from './types';

interface Props {
  crew?: Crew;
}
const { crew } = Astro.props;
---

{
  crew && (
    <dl class="grid gap-x-4 gap-y-2 text-[0.95rem] sm:grid-cols-[auto_1fr]">
      {crew.members.length > 0 && (
        <>
          <dt class="font-semibold text-muted">Crew</dt>
          <dd>
            {crew.members.map((m, i) => (
              <>
                {i > 0 && ', '}
                <a class="text-cyan underline-offset-4 hover:underline" href={m.url} rel="noopener">{m.login}</a>
              </>
            ))}
            {crew.note && <span class="text-muted"> ({crew.note})</span>}
          </dd>
        </>
      )}
      {crew.members.length === 0 && crew.note && (
        <>
          <dt class="font-semibold text-muted">Crew</dt>
          <dd class="text-muted">{crew.note}</dd>
        </>
      )}
      <dt class="font-semibold text-muted">My role</dt>
      <dd>{crew.myRole}</dd>
    </dl>
  )
}
